# --- Server ---
PORT=3000
# Public HTTPS URL for this server when testing locally (e.g. your ngrok URL).
# Not required by the app directly, but handy to have on hand for Twilio config.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# --- Database (Postgres via Prisma) ---
DATABASE_URL=postgresql://user:password@localhost:5432/dental_agent?schema=public

# --- Twilio (https://console.twilio.com) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# The Twilio phone number callers dial, in E.164 format. Must match a
# Business.phoneNumber row in the database.
TWILIO_PHONE_NUMBER=+15555550123

# --- Deepgram (https://console.deepgram.com) ---
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_MODEL=nova-2

# --- Anthropic / Claude (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Use whatever the latest/most capable Claude model available to your account is.
CLAUDE_MODEL=claude-sonnet-5

# --- ElevenLabs (https://elevenlabs.io/app/settings/api-keys) ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Voice ID from https://elevenlabs.io/app/voice-library (or your own cloned voice)
ELEVENLABS_VOICE_ID=your_voice_id
